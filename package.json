{
  "name": "@deedotman/mailcheckr",
  "version": "0.1.1",
  "description": "Node.js client for the MailCheckr email verification API",
  "keywords": [
    "mailcheckr",
    "email-verification",
    "email-validation",
    "email-deliverability",
    "webhooks",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/dotmarn/mailcheckr-nodejs.git" },
  "engines": { "node": ">=18" },
  "main": "./src/index.cjs",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.cjs"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": { "test": "node --test" }
}
